{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["amazon-bedrock", "azure"],
  "share": "disabled",
  "provider": {
    "amazon-bedrock": {
      "whitelist": ["minimax.minimax-m2.5"],
    },
    "azure": {
      "whitelist": ["deepseek-v4-flash"],
      "options": { "useCompletionUrls": true, "apiKey": "{env:AZURE_API_KEY}" },
    },
  },
  "permission": {
    "websearch": "ask",
    "edit": "ask",
    "bash": "ask",
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
